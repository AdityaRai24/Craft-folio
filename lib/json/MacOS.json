        {
            "data": {
                "content": "<div class=\"text-center mb-12\"><h1 class=\"text-4xl font-semibold mb-3\">Hi, I'm Jake Ryan</h1><p class=\"text-lg opacity-80\">Computer Science Student & Full Stack Developer</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\"><div class=\"p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-blue-50 dark:bg-blue-900/20\"><div class=\"text-4xl mb-4\">🎓</div><h3 class=\"text-xl font-semibold mb-2\">Education</h3><p class=\"text-sm opacity-80\">Southwestern University<br>BA in Computer Science<br>Minor in Business</p></div><div class=\"p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-purple-50 dark:bg-purple-900/20\"><div class=\"text-4xl mb-4\">💻</div><h3 class=\"text-xl font-semibold mb-2\">Development</h3><p class=\"text-sm opacity-80\">Full-stack development with Python, Java, React, and PostgreSQL. Experience with REST APIs and Docker.</p></div><div class=\"p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-yellow-50 dark:bg-yellow-900/20\"><div class=\"text-4xl mb-4\">🤖</div><h3 class=\"text-xl font-semibold mb-2\">Research</h3><p class=\"text-sm opacity-80\">AI research experience in procedural content generation and game development.</p></div></div><div class=\"p-8 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 mb-8\"><h2 class=\"text-2xl font-semibold mb-4\">About Me</h2><p class=\"mb-4 opacity-80\">I am a Computer Science student at Southwestern University with a passion for building software that solves real-world problems. My experience ranges from full-stack web development to artificial intelligence research.</p><p class=\"mb-4 opacity-80\">Currently, I am working as an Undergraduate Research Assistant at Texas A&M University, where I develop REST APIs and web applications to analyze educational data. I also serve as an IT Support Specialist, helping students and faculty with technical issues.</p></div>"
            },
            "type": "safari",
            "sectionTitle": "About Me",
            "sectionDescription": "My background and journey"
